# MIME types the host does not know about
AddType image/webp .webp
AddType font/woff2 .woff2

# BEGIN GZIP
<ifmodule mod_deflate.c>
AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/css application/x-javascript application/javascript
</ifmodule>
# END GZIP

RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} !^qtpass.org$ [NC]
RewriteRule ^(.*)$ https://qtpass.org/$1 [L,R=301]

ErrorDocument 404 /404.html

## EXPIRES CACHING ##
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access 1 year"
ExpiresByType image/jpeg "access 1 year"
ExpiresByType image/gif "access 1 year"
ExpiresByType image/png "access 1 year"
ExpiresByType text/css "access 1 month"
ExpiresByType text/html "access 1 hour"
ExpiresByType application/pdf "access 1 month"
ExpiresByType text/x-javascript "access 1 month"
ExpiresByType application/x-shockwave-flash "access 1 month"
ExpiresByType image/x-icon "access 1 year"
ExpiresByType application/javascript "access 1 month"
ExpiresByType image/svg+xml "access 1 year"
ExpiresByType font/woff2 "access 1 year"
ExpiresDefault "access 1 month"
</IfModule>
## EXPIRES CACHING ##

# Legacy anchor URLs from the single-page era of the site.
Redirect 301 /features /#features
Redirect 301 /installation /#installation
Redirect 301 /linux /#linux
Redirect 301 /windows /#windows-quick
Redirect 301 /osx /#macos-quick
Redirect 301 /dependencies /downloads#dependencies
Redirect 301 /security-considerations /old#security-considerations
Redirect 301 /planned-features /old#planned-features
Redirect 301 /known-issues /old#known-issues
Redirect 301 /cant-save-a-password /old#cant-save-a-password
Redirect 301 /i-have-an-issue-with-gnome-keyring /old#i-have-an-issue-with-gnome-keyring
Redirect 301 /can-i-import-from-keepass-lastpass-or-x /old#can-i-import-from-keepass-lastpass-or-x
Redirect 301 /current-FAQ /faq
Redirect 301 /where-can-i-ask-for-help /old#where-can-i-ask-for-help
Redirect 301 /changelogs /changelog

# Doxygen stopped rendering the Markdown files in April 2026 (#1087); these
# pages were removed from /docs/ in September 2026 but are still linked from
# packaging metadata and search results.
Redirect 301 /docs/md__f_a_q.html /faq
Redirect 301 /docs/md__c_h_a_n_g_e_l_o_g.html https://github.com/IJHack/QtPass/blob/main/CHANGELOG.md
Redirect 301 /docs/md__c_o_n_t_r_i_b_u_t_i_n_g.html /contributing
Redirect 301 /docs/md__r_e_a_d_m_e.html https://github.com/IJHack/QtPass/blob/main/README.md

# Canonical URLs are extension-less: /downloads.html -> /downloads.
# Not applied under /docs/ (Doxygen links use .html) and not to 404.html.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^./\s]+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/docs/
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^([^.]+)\.html$ /%1 [R=301,L]

# Service worker must never be served from a long-lived cache.
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE "application/atom+xml" \
                                  "application/javascript" \
                                  "application/json" \
                                  "application/ld+json" \
                                  "application/manifest+json" \
                                  "application/rdf+xml" \
                                  "application/rss+xml" \
                                  "application/schema+json" \
                                  "application/vnd.geo+json" \
                                  "application/vnd.ms-fontobject" \
                                  "application/x-font-ttf" \
                                  "application/x-javascript" \
                                  "application/x-web-app-manifest+json" \
                                  "application/xhtml+xml" \
                                  "application/xml" \
                                  "font/eot" \
                                  "font/opentype" \
                                  "image/bmp" \
                                  "image/svg+xml" \
                                  "image/vnd.microsoft.icon" \
                                  "image/x-icon" \
                                  "text/cache-manifest" \
                                  "text/css" \
                                  "text/html" \
                                  "text/javascript" \
                                  "text/plain" \
                                  "text/vcard" \
                                  "text/vnd.rim.location.xloc" \
                                  "text/vtt" \
                                  "text/x-component" \
                                  "text/x-cross-domain-policy" \
                                  "text/xml"
</IfModule>
